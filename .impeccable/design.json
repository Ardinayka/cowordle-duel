  "narrative": {
    "northStar": "The Night Scoreboard",
    "overview": "Dark, calm surfaces with the clues lit up like a scoreboard. The board and keyboard are the stars; everything else steps back. This is Operate mode: a competitive word game used on a phone, often outdoors and in short, interrupted sessions, so precision and restraint matter more than decoration.\n\nClues are read by shape first and colour second, so they survive colour blindness, greyscale and glare. The primary action is neutral (the ink colour), never a tile colour, so a button can never be mistaken for a clue. Each way to play has its own accent (Competitive violet, Normal cyan, Friend green, Bot slate), used for edges and labels, not for fills behind text.",
    "keyCharacteristics": [
      "Board and keyboard first; the keyboard stays fully on screen down to 320×568 and 683×384.",
      "Shape-coded clues on tiles and keys.",
      "Neutral primary action; accents name the way to play.",
      "Every match shows a label chip saying whether it is rated.",
      "Short, stateful motion that reduced-motion removes entirely."
    ],
    "rules": [
      {
        "name": "The Neutral Action Rule",
        "body": "The primary button uses the ink colour, never a tile or accent colour.",
        "section": "colors"
      },
      {
        "name": "The Seven-to-One Rule",
        "body": "Every tile and key letter is at least 7:1 against its fill in both themes; body text at least 4.5:1; control borders at least 3:1.",
        "section": "colors"
      },
      {
        "name": "The No-Glyph Rule",
        "body": "No Unicode glyphs for icons or clues. Icons are drawn SVG (24 px, 2 px stroke, round caps).",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep motion short and stateful (150–420 ms, exponential ease-out): tile flip on reveal (90 ms stagger), invalid-word shake, invitation banner slide, result medal spring on a win, urgent-timer pulse, search radar.",
      "Do remove all of that motion under `prefers-reduced-motion`.",
      "Do check every visual change at 320, 390, 768 and 1366 px, at 683×384 (200% desktop zoom) and at 200% text, in both themes (see AGENTS.md)."
    ],
    "donts": [
      "Don't use a tile colour or accent as the primary button fill.",
      "Don't convey a clue by colour alone.",
      "Don't put anything over the board or keyboard during play.",
      "Don't use Unicode glyphs as icons."
    ]
  },
  "reference": "https://www.figma.com/design/KeY08mZ8AcKEfxFJAHAido"
}
